# Meilisearch Configuration
MEILISEARCH_HOST=127.0.0.1
MEILISEARCH_PORT=7700
MEILISEARCH_API_KEY=meilisearch-api-key

# OCR Dataset Paths 
OCR_DATASETS=/lucifer_data/ocr-dataset

# Subtitle Dataset Paths
SUBTITLE_DATASETS=/lucifer_data/subtitle-dataset

# Meilisearch Search Limits
MEILISEARCH_LIMIT_SEARCH=500

# Model Configurations
# Device configuration: cuda:0, cuda:1, cpu
DEVICE_0=cuda:0
DEVICE_1=cuda:1
USE_GPU=true

# CLIP Model 1
MODEL_1_NAME=ViT-H-14-378-quickgelu
MODEL_1_WEIGHT=0.55
MODEL_1_PRETRAINED=dfn5b
MODEL_1_EMBEDDING_PATH=/path/to/clip/embedding_info.pkl
MODEL_1_INDEX_TYPE=Flat
MODEL_1_INPUT_INDEX_PATH=/lucifer_data/faiss-index/clip-index
MODEL_1_OUTPUT_INDEX_PATH=/app/outputs/clip-index

# SigLIP Model 2
MODEL_2_NAME=ViT-gopt-16-SigLIP2-384
MODEL_2_WEIGHT=0.45
MODEL_2_PRETRAINED=webli
MODEL_2_EMBEDDING_PATH=/path/to/siglip/embedding_info.pkl
MODEL_2_INDEX_TYPE=Flat
MODEL_2_INPUT_INDEX_PATH=/lucifer_data/faiss-index/siglip-index
MODEL_2_OUTPUT_INDEX_PATH=/app/outputs/siglip-index

# FAISS Configuration
FAISS_USE_GPU=true
FAISS_NPROBE=64
FAISS_NLIST=1024

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Search Default Parameters
DEFAULT_TOP_K=10
DEFAULT_TEMPORAL_TIME=30
DEFAULT_INITIAL_SEARCH_K=2048

# Fusion Weights
WEIGHT_TEXT=0.3
WEIGHT_OCR=0.3
WEIGHT_SUBTITLE=0.3
WEIGHT_IMAGE=0.1

# Segment Path
SEGMENT_PATH=/lucifer_data/video-segments